<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Escalation_Reason_Default</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL(Status__c, &apos;Escalated&apos;)), NOT(ISBLANK(Escalation_Reason__c)))</errorConditionFormula>
    <errorMessage>Please do not enter an escalation reason when the status is not escalated.</errorMessage>
</ValidationRule>
