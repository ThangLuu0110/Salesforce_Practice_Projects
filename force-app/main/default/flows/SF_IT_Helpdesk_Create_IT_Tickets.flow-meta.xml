        <text>&lt;p&gt;&lt;strong&gt;Company Asset: &lt;/strong&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Confirmation_Template</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;You are about to submit this ticket:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Subject:&lt;/strong&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt; {!Ticket_Subject}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Category:&lt;/strong&gt; {!Category}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Priority:&lt;/strong&gt; {!Priority}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Description:&lt;/strong&gt; {!Ticket_Description}&lt;/p&gt;&lt;p&gt;{!Related_Asset_Text_Cond}&lt;/p&gt;</text>
    </textTemplates>
</Flow>
