        <picklistField>Priority__c</picklistField>
        <picklistObject>IT_Ticket__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>Related_Asset_Text_Cond</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Related_Asset.recordId})), {!Company_Asset_Text} + {!Related_Asset.recordName}, &quot;&quot;)</expression>
    </formulas>
    <interviewLabel>[SF_IT-Helpdesk] Create IT Tickets {!$Flow.CurrentDateTime}</interviewLabel>
